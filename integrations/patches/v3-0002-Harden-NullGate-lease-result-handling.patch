+    ) {
+        if (NullGateResultPolicy.evaluateReconciliation(
+                resultCode == Activity.RESULT_CANCELED, keys, decision
+            ) != NullGateResultPolicy.Outcome.CLEAN
+        ) {
+            markUnknown("NullGate reconciliation is still uncertain.")
+            return
