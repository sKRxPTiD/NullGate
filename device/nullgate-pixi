#!/usr/bin/env bash
set -uo pipefail

SERIAL="${NULLGATE_SERIAL:-54110DLAQ0043W}"
PROJECT="/mnt/TerraDrive/Null Protocol/Apps/NullGate/source"
HELPER="$PROJECT/device/nullgate-device-v2.sh"
TOKEN="NULLGATE_MARKER_TEST_V1"
THEME_TOKEN="NULLGATE_SYSTEM_THEME_V1"
PACKAGE="org.nullprotocol.nullgate"
COLORBLENDR_PACKAGE="com.drdisagree.colorblendr"
RUNTIME="/data/local/tmp/nullgate"
ADB_BIN="${ADB_BIN:-adb}"
ANDROID_SDK="${ANDROID_HOME:-$HOME/Android/Sdk}"
APKSIGNER="${APKSIGNER_BIN:-$ANDROID_SDK/build-tools/36.0.0/apksigner}"
AAPT2="${AAPT2_BIN:-$ANDROID_SDK/build-tools/36.0.0/aapt2}"
PRIVATE_PINS="$PROJECT/compat/pixi-private-pins.properties"

info() {
  local rendered
  printf -v rendered '%b' "$1"
  if [[ "${NULLGATE_NO_DIALOG:-0}" != 1 && -n "${DISPLAY:-}" ]] && command -v zenity >/dev/null; then
    zenity --info --title="NullGate" --width=470 --text="$rendered"
  else
    printf 'NullGate: %s\n' "$rendered"
  fi
}

fail() {
  local rendered
  printf -v rendered '%b' "$1"
  if [[ "${NULLGATE_NO_DIALOG:-0}" != 1 && -n "${DISPLAY:-}" ]] && command -v zenity >/dev/null; then
    zenity --error --title="NullGate stopped safely" --width=520 --text="$rendered"
  else
    printf 'NullGate: %s\n' "$rendered" >&2
  fi
  return 1
}

adb_pixi() { "$ADB_BIN" -s "$SERIAL" "$@"; }

helper_read() {
  NULLGATE_SERIAL="$SERIAL" ADB_BIN="$ADB_BIN" APKSIGNER_BIN="$APKSIGNER" \
    AAPT2_BIN="$AAPT2" "$HELPER" "$@"
}

helper_write() {
  NULLGATE_SERIAL="$SERIAL" NULLGATE_MUTATION_TOKEN="$TOKEN" ADB_BIN="$ADB_BIN" \
    APKSIGNER_BIN="$APKSIGNER" AAPT2_BIN="$AAPT2" "$HELPER" "$@"
}

helper_theme() {
  NULLGATE_SERIAL="$SERIAL" NULLGATE_MUTATION_TOKEN="$THEME_TOKEN" ADB_BIN="$ADB_BIN" \
    APKSIGNER_BIN="$APKSIGNER" AAPT2_BIN="$AAPT2" "$HELPER" "$@"
}

require_connection() {
  [[ "$(adb_pixi get-state 2>/dev/null)" == device ]] || {
    fail "PiXi is not available through ADB.\n\nPlug her in, unlock her, and approve USB debugging."
    return 1
  }
}

activate_root() {
  local output identity context enforcement
  output="$(adb_pixi root 2>&1)" || {
    fail "Rooted ADB could not start.\n\nOn PiXi, enable Developer options → Rooted debugging, then try again.\n\n$output"
    return 1
  }
  timeout 15s "$ADB_BIN" -s "$SERIAL" wait-for-device >/dev/null 2>&1 || {
    fail "PiXi did not reconnect after starting rooted ADB."
    return 1
  }
  identity="$(adb_pixi shell id 2>/dev/null | tr -d '\r')"
  context="$(adb_pixi shell id -Z 2>/dev/null | tr -d '\r')"
  enforcement="$(adb_pixi shell getenforce 2>/dev/null | tr -d '\r')"
  [[ "$identity" == uid=0\(* && "$context" == u:r:su:s0 && "$enforcement" == Enforcing ]] || {
    fail "Root verification failed. Nothing was deployed.\n\nIdentity: $identity\nContext: $context\nSELinux: $enforcement"
    return 1
  }
}

deactivate_root() {
  local output identity
  output="$(adb_pixi unroot 2>&1)" || {
    fail "ADB could not return to non-root. Rooted debugging must be disabled manually.\n\n$output"
    return 1
  }
  timeout 15s "$ADB_BIN" -s "$SERIAL" wait-for-device >/dev/null 2>&1 || {
    fail "PiXi did not reconnect after ADB was returned to non-root."
    return 1
  }
  identity="$(adb_pixi shell id 2>/dev/null | tr -d '\r')"
  [[ "$identity" == uid=2000\(* ]] || {
    fail "ADB did not verify as ordinary shell after unroot. Disable Rooted debugging manually.\n\n$identity"
    return 1
  }
}

runtime_state() {
  adb_pixi shell "if test -L $RUNTIME; then echo SYMLINK; elif test -d $RUNTIME; then stat -c 'DIR:%u:%a' $RUNTIME; elif test -e $RUNTIME; then echo OTHER; else echo ABSENT; fi" 2>/dev/null | tr -d '\r'
}

start_session() {
  require_connection || return 1
  activate_root || return 1

  local preflight state status_output
  preflight="$(helper_read preflight 2>&1)" || {
    fail "NullGate preflight failed. Nothing new was launched.\n\n$preflight"
    return 1
  }
  state="$(runtime_state)"
  if [[ "$state" == ABSENT ]]; then
    status_output="$(helper_theme deploy-system-theme 2>&1)" || {
      fail "The broker did not start. Its evidence was preserved for inspection.\n\n$status_output"
      return 1
    }
  elif status_output="$(helper_read status 2>&1)"; then
    status_output="The verified broker was already running."
  else
    fail "A previous NullGate runtime needs inspection. Do not request a lease.\n\nUse ‘Recover verified stale runtime’ or return to Codex.\n\n$status_output"
    return 1
  fi

  adb_pixi shell am start -W -n "$PACKAGE/.MainActivity" >/dev/null 2>&1 || {
    fail "The broker is running, but the controller screen could not be opened. Stop and clean the session before disconnecting."
    return 1
  }
  adb_pixi shell am start -W -n "com.drdisagree.colorblendr/.ui.activities.MainActivity" >/dev/null 2>&1 || true
  info "NullGate is ready for ColorBlendr.\n\nIf ColorBlendr Settings says Theming is inactive, turn its service on and approve the request. If it is already active, choose a color, tap Apply, and approve the request.\n\nWhen finished, switch ColorBlendr theming off, then use this launcher again and choose Stop and clean session."
}

start_colorblendr_session() {
  start_session
}

stop_session() {
  require_connection || return 1
  activate_root || return 1

  local state output
  state="$(runtime_state)"
  if [[ "$state" == ABSENT ]]; then
    output="$(helper_read verify-clean 2>&1)" || {
      fail "The managed runtime is absent, but clean-state verification failed.\n\n$output"
      return 1
    }
    deactivate_root || return 1
    info "NullGate was already clean. ADB was returned to non-root.\n\nTurn off Rooted debugging on PiXi if it is still enabled."
    return
  fi
  output="$(helper_write stop 2>&1)" || {
    fail "NullGate did not confirm a clean stop. No forced kill or cleanup was attempted.\n\nUse Status, then Recover only if the broker has expired or stopped.\n\n$output"
    return 1
  }
  output="$(helper_write cleanup 2>&1)" || {
    fail "The broker stopped, but cleanup was not confirmed. Evidence was preserved.\n\n$output"
    return 1
  }
  output="$(helper_read verify-clean 2>&1)" || {
    fail "Final clean-state verification failed.\n\n$output"
    return 1
  }
  deactivate_root || return 1
  info "Session closed cleanly.\n\nThe broker stopped, lease markers are absent, the log was archived, the temporary runtime was removed, and ADB returned to non-root.\n\nNow turn off Rooted debugging on PiXi."
}

show_status() {
  require_connection || return 1
  local identity package_path output
  identity="$(adb_pixi shell id 2>/dev/null | tr -d '\r')"
  package_path="$(adb_pixi shell pm path "$PACKAGE" 2>/dev/null | tr -d '\r')"
  if [[ "$identity" == uid=0\(* ]]; then
    output="$(helper_read status 2>&1)" || true
  else
    output="Rooted ADB is not active, so the root runtime is not being inferred."
  fi
  info "PiXi connection: yes\nADB identity: $identity\nController installed: $([[ -n "$package_path" ]] && echo yes || echo no)\n\n$output"
}

installed_apk_path() {
  local package_name="$1" output path count
  output="$(adb_pixi shell pm path "$package_name" 2>/dev/null | tr -d '\r')" || return 1
  count="$(printf '%s\n' "$output" | sed -n 's/^package://p' | wc -l | tr -d '[:space:]')"
  [[ "$count" == 1 ]] || return 1
  path="$(printf '%s\n' "$output" | sed -n 's/^package://p')"
  [[ "$path" == /data/app/*/base.apk ]] || return 1
  printf '%s\n' "$path"
}

installed_signer() {
  local package_name="$1" temp_dir apk_path digest
  apk_path="$(installed_apk_path "$package_name")" || return 1
  temp_dir="$(mktemp -d)"
  adb_pixi pull "$apk_path" "$temp_dir/base.apk" >/dev/null 2>&1 || {
    rm -rf -- "$temp_dir"
    return 1
  }
  digest="$("$APKSIGNER" verify --print-certs "$temp_dir/base.apk" 2>/dev/null \
    | sed -n 's/^Signer #[0-9][0-9]* certificate SHA-256 digest: //p')"
  rm -rf -- "$temp_dir"
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$digest"
}

read_private_pin() {
  local key="$1" value
  [[ -f "$PRIVATE_PINS" && ! -L "$PRIVATE_PINS" ]] || return 1
  value="$(sed -n "s/^${key}=//p" "$PRIVATE_PINS")"
  [[ -n "$value" && "$(printf '%s\n' "$value" | wc -l)" == 1 ]] || return 1
  printf '%s\n' "$value"
}

health_check() {
  require_connection || return 1
  [[ -x "$APKSIGNER" ]] || {
    fail "Android APK signature verification is unavailable on DoloWOLF."
    return 1
  }

  local identity controller_signer colorblendr_signer controller_version colorblendr_version runtime
  local expected_controller_signer expected_colorblendr_signer expected_controller_version expected_colorblendr_version
  expected_controller_signer="$(read_private_pin controller.signer.sha256)" || {
    fail "The PiXi private controller identity pin is unavailable."
    return 1
  }
  expected_colorblendr_signer="$(read_private_pin colorblendr.signer.sha256)" || {
    fail "The PiXi private ColorBlendr identity pin is unavailable."
    return 1
  }
  expected_controller_version="$(read_private_pin controller.versionCode)" || return 1
  expected_colorblendr_version="$(read_private_pin colorblendr.versionCode)" || return 1
  [[ "$expected_controller_signer" =~ ^[0-9a-f]{64}$ &&
      "$expected_colorblendr_signer" =~ ^[0-9a-f]{64}$ &&
      "$expected_controller_version" =~ ^[0-9]+$ &&
      "$expected_colorblendr_version" =~ ^[0-9]+$ ]] || {
    fail "The PiXi private identity metadata is malformed."
    return 1
  }
  identity="$(adb_pixi shell id 2>/dev/null | tr -d '\r')"
  [[ "$identity" == uid=2000\(* ]] || {
    fail "PiXi is connected, but ADB is not in its normal non-root state. Close the active session first.\n\n$identity"
    return 1
  }
  controller_signer="$(installed_signer "$PACKAGE")" || {
    fail "The installed NullGate controller identity could not be verified."
    return 1
  }
  colorblendr_signer="$(installed_signer "$COLORBLENDR_PACKAGE")" || {
    fail "The installed ColorBlendr fork identity could not be verified."
    return 1
  }
  [[ "$controller_signer" == "$expected_controller_signer" ]] || {
    fail "The installed NullGate controller signer does not match the paired PiXi build."
    return 1
  }
  [[ "$colorblendr_signer" == "$expected_colorblendr_signer" ]] || {
    fail "The installed ColorBlendr signer does not match the admitted private fork."
    return 1
  }
  controller_version="$(adb_pixi shell dumpsys package "$PACKAGE" 2>/dev/null | sed -n 's/^[[:space:]]*versionCode=\([0-9]*\).*/\1/p' | head -1 | tr -d '\r')"
  colorblendr_version="$(adb_pixi shell dumpsys package "$COLORBLENDR_PACKAGE" 2>/dev/null | sed -n 's/^[[:space:]]*versionCode=\([0-9]*\).*/\1/p' | head -1 | tr -d '\r')"
  [[ "$controller_version" == "$expected_controller_version" &&
      "$colorblendr_version" == "$expected_colorblendr_version" ]] || {
    fail "Installed version pins do not match the verified pair.\n\nController: $controller_version\nColorBlendr: $colorblendr_version"
    return 1
  }
  runtime="$(runtime_state)"
  [[ "$runtime" == ABSENT ]] || {
    fail "A NullGate runtime still exists: $runtime\n\nUse Status and the guarded Stop or Recovery action."
    return 1
  }
  info "PiXi NullGate health check passed.\n\nADB: ordinary shell\nController: version $controller_version, paired signer verified\nColorBlendr: version $colorblendr_version, admitted signer verified\nRuntime: absent\nDevice writes performed: none"
}

recover_runtime() {
  require_connection || return 1
  if [[ "${NULLGATE_NO_DIALOG:-0}" != 1 && -n "${DISPLAY:-}" ]] && command -v zenity >/dev/null; then
    zenity --question --title="NullGate recovery" --width=510 \
      --text="Use recovery only after the broker stopped or its 15-minute lifetime expired. The helper will refuse unsafe files or a live process. Continue?" || return
  fi
  activate_root || return 1
  local output snapshot_state
  snapshot_state="$(adb_pixi shell "if test -L $RUNTIME/theme.snapshot; then echo SYMLINK; elif test -f $RUNTIME/theme.snapshot; then echo FILE; elif test -e $RUNTIME/theme.snapshot; then echo OTHER; else echo ABSENT; fi" 2>/dev/null | tr -d '\r')"
  case "$snapshot_state" in
    FILE) output="$(helper_theme recover-system-theme-runtime 2>&1)" ;;
    ABSENT) output="$(helper_write recover-marker-runtime 2>&1)" ;;
    *) fail "Recovery refused an unsafe theme-snapshot state: $snapshot_state"; return 1 ;;
  esac || {
    fail "Recovery refused the current state. Evidence remains untouched.\n\n$output"
    return 1
  }
  output="$(helper_read verify-clean 2>&1)" || {
    fail "Recovery ran, but final verification failed.\n\n$output"
    return 1
  }
  deactivate_root || return 1
  info "Verified stale runtime recovered and ADB returned to non-root.\n\nTurn off Rooted debugging on PiXi."
}

menu() {
  while true; do
    local choice
    if [[ "${NULLGATE_NO_DIALOG:-0}" != 1 && -n "${DISPLAY:-}" ]] \
        && command -v zenity >/dev/null 2>&1; then
      choice="$(zenity --list --title="NullGate · PiXi" --width=620 --height=380 \
        --text="PiXi must be plugged in and unlocked. Enable Rooted debugging before Start, Stop, or Recovery." \
        --column="Action" --column="What it does" \
        "Start ColorBlendr NullGate session" "Verify PiXi and launch the temporary theme broker" \
        "Stop and clean session" "Revoke/stop, archive the log, remove runtime, unroot ADB" \
        "Show status" "Read connection and verified broker status" \
        "Run read-only health check" "Verify installed identities and clean idle state" \
        "Recover verified stale runtime" "Guarded cleanup after expiry or an interrupted session" \
        "Exit" "Close this launcher" 2>/dev/null)" || return
    else
      printf '\nNullGate · PiXi — device must be plugged in and unlocked.\n'
      printf 'Enable Rooted debugging only for Start, Stop, or Recovery.\n'
      printf '1) Start ColorBlendr session\n2) Stop and clean session\n'
      printf '3) Show status\n4) Read-only health check\n'
      printf '5) Recover verified stale runtime\n6) Exit\n'
      read -r -p 'Select [1-6]: ' selection || return
      case "$selection" in
        1) choice="Start ColorBlendr NullGate session" ;;
        2) choice="Stop and clean session" ;;
        3) choice="Show status" ;;
        4) choice="Run read-only health check" ;;
        5) choice="Recover verified stale runtime" ;;
        *) return ;;
      esac
    fi
    case "$choice" in
      "Start ColorBlendr NullGate session") start_session ;;
      "Stop and clean session") stop_session ;;
      "Show status") show_status ;;
      "Run read-only health check") health_check ;;
      "Recover verified stale runtime") recover_runtime ;;
      *) return ;;
    esac
  done
}

case "${1:-menu}" in
  menu) menu ;;
  start) start_session ;;
  colorblendr) start_colorblendr_session ;;
  stop) stop_session ;;
  status) show_status ;;
  doctor) health_check ;;
  recover) recover_runtime ;;
  *) printf 'Usage: nullgate-pixi {menu|start|colorblendr|stop|status|doctor|recover}\n' >&2; exit 2 ;;
esac
